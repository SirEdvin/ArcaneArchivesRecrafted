{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": ["${authors}"],
  "license": "${license}",
  "environment": "*",
  "mixins": ["arcanearchives.fabric.mixins.json", "arcanearchives.mixins.json"],
  "entrypoints": {
    "main": ["com.aranaira.arcanearchives.ArcaneArchivesFabric"],
    "client": ["com.aranaira.arcanearchives.client.ArcaneArchivesFabricClient"]
  },
  "depends": {
    "fabricloader": ">=0.17",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*",
    "patchouli": "=${patchouli}"
  }
}
